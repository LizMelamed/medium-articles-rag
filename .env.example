# OpenAI-compatible API settings supplied by the course/provider.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=4UHRUIN-text-embedding-3-small
CHAT_MODEL=4UHRUIN-gpt-5-mini

# Pinecone settings. Use the host for your 1536-dimension index.
PINECONE_API_KEY=
PINECONE_INDEX_HOST=https://YOUR_INDEX_HOST.pinecone.io
PINECONE_API_VERSION=2025-10
PINECONE_NAMESPACE=medium-articles-512

# RAG hyperparameters reported by /api/stats.
CHUNK_SIZE=512
OVERLAP_RATIO=0.2
TOP_K=12
INTERNAL_TOP_K=48
